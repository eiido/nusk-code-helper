# Required for shared submissions and moderation. Never expose service_role to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma separated emails of existing Supabase Auth users. Public account signup is unnecessary.
ADMIN_EMAILS=
# At least 32 random characters; used to hash rate-limit identifiers, never raw IP storage.
RATE_LIMIT_SECRET=
# Optional: absolute public URL used by metadata and canonical links, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=
